{
  "name": "planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/precache.js",
    "preview": "vite preview --host 0.0.0.0",
    "worker": "wrangler dev --config wrangler.local.toml",
    "test": "node --test tests/*.test.js",
    "test:visual": "node tests/visual.js",
    "deploy": "npm run build && wrangler deploy",
    "test:browser": "node tests/browser.js",
    "format": "prettier --write src server tests scripts public/*.js public/*.webmanifest index.html vite.config.js README.md"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.2.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "prettier": "^3.9.10",
    "vite": "^7.2.2",
    "wrangler": "^4.45.0"
  },
  "engines": {
    "node": ">=24"
  }
}
